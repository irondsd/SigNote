{
  "name": "signote-desktop",
  "version": "0.1.0",
  "description": "Secure desktop shell for SigNote",
  "author": "SigNote",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "dev": "bun run build && electron .",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.0.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "app.signote.desktop",
    "productName": "SigNote",
    "asar": true,
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "SigNote",
        "schemes": [
          "signote"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        }
      },
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}

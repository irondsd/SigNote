# web3
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
NEXT_PUBLIC_RPC_URL=""

# posthog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST=""

# database — the local Postgres from docker-compose (`bun run db:up`).
# Production lives in a separate, gitignored .env.prod, read only by the
# `:prod` drizzle-kit scripts; the deployed app gets its env from the host.
DATABASE_URL="postgres://signote:signote@localhost:5434/signote"

# auth
NEXTAUTH_URL="http://localhost:5000"
NEXTAUTH_SECRET=""

# google oauth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# aws s3
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT=""

# cron job
CRON_SECRET=""

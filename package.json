{
  "name": "signote",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:push:prod": "DRIZZLE_ENV=.env.prod drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "DRIZZLE_ENV=.env.prod drizzle-kit studio",
    "db:seed": "bun run ./scripts/seedLocalDb.ts",
    "db:wipe": "bun run ./scripts/wipeLocalDb.ts",
    "dev:test": "next dev -p 5005",
    "email": "email dev --dir email/emails --port 3001",
    "build": "next build --webpack",
    "desktop:build": "bun run --cwd desktop build",
    "desktop:dev": "bun run --cwd desktop dev",
    "desktop:pack": "bun run --cwd desktop pack",
    "desktop:dist": "bun run --cwd desktop dist",
    "desktop:dist:win": "bun run --cwd desktop dist:win",
    "desktop:dist:win:release": "bun run --cwd desktop dist:win:release",
    "desktop:dist:linux": "bun run --cwd desktop dist:linux",
    "desktop:dist:release": "bun run --cwd desktop dist:release",
    "desktop:test": "bun run --cwd desktop test",
    "icons:web": "node scripts/build-web-icons.mjs",
    "start": "next start",
    "lint": "eslint && npx tsc --noEmit",
    "format": "prettier --write . | { grep -v '(unchanged)' || true; }",
    "test:bundle": "node tests/provider/bundle.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:prepare": "bun scripts/test-e2e-prepare.ts",
    "test:rotation:locks": "bun tests/rotation/locks.ts",
    "test:rotation:storage": "bun tests/rotation/storage.ts --restart",
    "test:rotation:integration": "bun tests/rotation/integration.ts"
  },
